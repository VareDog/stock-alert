{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-alert",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock-alert",
      "database_id": "a984695f-e97f-4ea7-afa2-eac64b34a4f7"
    }
  ]
}
